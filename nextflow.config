// Pipeline parameters
// params.input_reads = "sample_reads"
params.output_dir = "results"
params.reference_genome = "ref/GCF_000149955.1_ASM14995v2_genomic.fna.gz"
params.samplesheet_path = "samplesheet.csv"
params.conda_shell = "$HOME/miniconda3/etc/profile.d/conda.sh"
params.project_root = "$projectDir"
params.home = "$HOME"

// SnpEff
params.snpeff_jar = "${params.home}/miniconda3/envs/snpeff/share/snpeff-5.2-1/snpEff.jar"
params.snpeff_db = "Fusarium_oxysporum_f_sp_lycopersici_4287_gca_000149955"
params.chr_rename_map = "${projectDir}/utilities/chr_rename_map.txt"

// BLAST
params.blast_db_dir = "/mnt/1/blast/db/core_nt"
params.blast_evalue = "1e-5"
params.blast_max_target_seqs = "5"
params.merops_db_dir = "$HOME/MEROPS/merops_db"

// binaries
params.mcclintock = "$HOME/McClintock/mcclintock.py"
params.targetp = "$HOME/targetp-2.0/bin/targetp"

// dbCAN
params.dbcan_db_dir = "/mnt/1/dbCAN/db"

params.skip_deeptmhmm = false

conda.enabled = true